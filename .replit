modules = ["nodejs-20"]

[[ports]]
localPort = 3001
externalPort = 80

[[ports]]
localPort = 5000

[[ports]]
localPort = 5001

[[ports]]
localPort = 8081

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd campuscart-web && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && npm run dev"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd backend && npm start & cd ../campuscart-web && npm run preview -- --port 5000 --host 0.0.0.0"]
build = ["bash", "-c", "cd campuscart-web && npm install && npm run build && cd ../backend && npm install && npm run build"]
